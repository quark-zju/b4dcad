def cross_section(solid: Solid, z: float = ...) -> Shape: ...
def text(t: str, size: float = ..., font: str = ..., fn: int = ...) -> Shape: ...
def threads(
    d: float = ...,
    h: float = ...,
    pitch: float = ...,
    depth_ratio: float = ...,
    trap_scale: float = ...,
    starts: int = ...,
    fn: int = ...,
    pitch_fn: int = ...,
    lefty: bool = ...,
) -> Solid: ...
def load_stl(filename: str | None = ..., data: bytes | None = ...) -> Solid: ...
def to_cq(obj: Solid | Manifold) -> cq.Workplane: ...
def from_cq(obj: cq.Workplane, tolerance: float = ...) -> Solid: ...
